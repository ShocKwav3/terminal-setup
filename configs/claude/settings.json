{
  "permissions": {
    "deny": [
      "DesignSync",
      "NotebookEdit",
      "PushNotification",
      "RemoteTrigger",
      "ScheduleWakeup",
      "CronCreate",
      "CronDelete",
      "CronList",
      "ReportFindings"
    ]
  },
  "model": "opus[1m]",
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "plannotator@plannotator": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "medium"
    }
  },
  "pluginConfigs": {
    "ponytail@ponytail": {
      "options": {
        "ledger": true,
        "sendNames": true
      }
    }
  },
  "autoMemoryEnabled": false,
  "theme": "dark",
  "idleCompaction": false
}
